<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.HOSPITALAppointmentMobileApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HOSPITALAppointmentMobileApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WelcomeActivity" android:exported="false" />
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".RoleActivity" android:exported="false" />
        <activity android:name=".auth.RegisterActivity" android:exported="false" />

        <!-- Patient Activities -->
        <activity android:name=".patient.PatientDashboardActivity" android:exported="false" />
        <activity android:name=".patient.DoctorListActivity" android:exported="false" />
        <activity android:name=".patient.DoctorDetailsActivity" android:exported="false" />
        <activity android:name=".patient.BookAppointmentActivity" android:exported="false" />
        <activity android:name=".patient.MyAppointmentsActivity" android:exported="false" />
        <activity android:name=".patient.PatientProfileActivity" android:exported="false" />

        <!-- Doctor Activities -->
        <activity android:name=".doctor.DoctorDashboardActivity" android:exported="false" />
        <activity android:name=".doctor.DoctorAppointmentsActivity" android:exported="false" />
        <activity android:name=".doctor.DoctorProfileActivity" android:exported="false" />

        <!-- Admin Activities -->
        <activity android:name=".admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".admin.ManageDoctorsActivity" android:exported="false" />
        <activity android:name=".admin.AdminReportsActivity" android:exported="false" />
        <activity android:name=".admin.ManagePatientsActivity" android:exported="false" />
        <activity android:name=".admin.ManageDepartmentsActivity" android:exported="false" />

    </application>

</manifest>